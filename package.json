{
  "name": "vendlists-agent-kit",
  "version": "1.2.0",
  "description": "An eBay listing assistant for Claude: local MCP tools, photo-to-listing workflow and listing-quality review with Vendlists.",
  "scripts": {
    "mcp": "node mcp/server.mjs",
    "check": "node scripts/check-live-api.mjs",
    "smoke": "node mcp/smoke-test.mjs",
    "test": "node mcp/workflow-test.mjs",
    "lint": "node --check mcp/server.mjs && node --check mcp/listings.mjs && node --check mcp/workflow-test.mjs && node --check mcp/smoke-test.mjs && node --check scripts/check-live-api.mjs"
  },
  "keywords": [
    "ebay",
    "ebay-api",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "llm-tools",
    "openapi",
    "listing",
    "reselling",
    "chatgpt",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "type": "module",
  "bin": {
    "vendlists-mcp": "mcp/server.mjs"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "skills",
    "docs",
    "mcp",
    "prompts",
    "examples",
    "scripts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/pangu25/vendlists-agent-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pangu25/vendlists-agent-kit.git"
  },
  "main": "mcp/server.mjs"
}
